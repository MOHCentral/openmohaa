
//
// Stats Logger Example Script
//

// Initialize the stats logger
main:
    println "Initializing Stats Logger..."

    // Combat Hooks
    event_subscribe "player_kill" "stats_player_kill"
    event_subscribe "player_death" "stats_player_death"
    event_subscribe "player_damage" "stats_player_damage"
    event_subscribe "weapon_fire" "stats_weapon_fire"
    event_subscribe "weapon_hit" "stats_weapon_hit"
    event_subscribe "player_headshot" "stats_player_headshot"
    event_subscribe "weapon_reload" "stats_weapon_reload"
    event_subscribe "weapon_change" "stats_weapon_change"
    event_subscribe "grenade_throw" "stats_grenade_throw"
    event_subscribe "grenade_explode" "stats_grenade_explode"

    // Movement Hooks
    event_subscribe "player_jump" "stats_player_jump"
    event_subscribe "player_land" "stats_player_land"
    event_subscribe "player_crouch" "stats_player_crouch"
    event_subscribe "player_prone" "stats_player_prone"
    event_subscribe "player_distance" "stats_player_distance"

    // Interaction Hooks
    event_subscribe "ladder_mount" "stats_ladder_mount"
    event_subscribe "ladder_dismount" "stats_ladder_dismount"
    event_subscribe "item_pickup" "stats_item_pickup"
    event_subscribe "item_drop" "stats_item_drop"
    event_subscribe "player_use" "stats_player_use"

    // Session Hooks
    event_subscribe "client_connect" "stats_client_connect"
    event_subscribe "client_disconnect" "stats_client_disconnect"
    event_subscribe "client_begin" "stats_client_begin"
    event_subscribe "team_join" "stats_team_join"
    event_subscribe "player_say" "stats_player_say"

    println "Stats Logger Initialized."
end

// Combat Callbacks
stats_player_kill:
    // Args: attacker, victim, inflictor, location, meansofdeath
    local.attacker = parm.get 1
    local.victim = parm.get 2
    local.inflictor = parm.get 3
    local.hitloc = parm.get 4
    local.mod = parm.get 5
    println ("STATS: Kill - Attacker: " + local.attacker + " Victim: " + local.victim)
end

stats_player_death:
    // Args: inflictor
    local.inflictor = parm.get 1
    println ("STATS: Death - Inflictor: " + local.inflictor)
end

stats_player_damage:
    // Args: attacker, amount, mod
    local.attacker = parm.get 1
    local.amount = parm.get 2
    local.mod = parm.get 3
    println ("STATS: Damage - Attacker: " + local.attacker + " Amount: " + local.amount)
end

stats_weapon_fire:
    // Args: weapon, ammo
    local.weapon = parm.get 1
    local.ammo = parm.get 2
    println ("STATS: Fire - Weapon: " + local.weapon + " Ammo: " + local.ammo)
end

stats_weapon_hit:
    // Args: target, location (or type)
    local.target = parm.get 1
    local.location = parm.get 2
    println ("STATS: Hit - Target: " + local.target)
end

stats_player_headshot:
    // Args: target, weapon
    local.target = parm.get 1
    local.weapon = parm.get 2
    println ("STATS: HEADSHOT - Target: " + local.target + " Weapon: " + local.weapon)
end

stats_weapon_reload:
    // Args: weapon
    local.weapon = parm.get 1
    println ("STATS: Reload - Weapon: " + local.weapon)
end

stats_weapon_change:
    // Args: old, new
    local.old = parm.get 1
    local.new = parm.get 2
    println ("STATS: Weapon Change - Old: " + local.old + " New: " + local.new)
end

stats_grenade_throw:
    // Args: projectile
    local.proj = parm.get 1
    println "STATS: Grenade Thrown"
end

stats_grenade_explode:
    // Args: projectile
    local.proj = parm.get 1
    println "STATS: Grenade Explode"
end

// Movement Callbacks
stats_player_jump:
    println "STATS: Jump"
end

stats_player_land:
    // Args: height
    local.height = parm.get 1
    println ("STATS: Land - Height: " + local.height)
end

stats_player_crouch:
    println "STATS: Crouch"
end

stats_player_prone:
    println "STATS: Prone"
end

stats_player_distance:
    // Args: walked, sprinted, swam, driven
    local.walked = parm.get 1
    local.sprinted = parm.get 2
    local.swam = parm.get 3
    local.driven = parm.get 4
    println ("STATS: Distance - Walk: " + local.walked + " Sprint: " + local.sprinted)
end

// Interaction Callbacks
stats_ladder_mount:
    local.ladder = parm.get 1
    println "STATS: Ladder Mount"
end

stats_ladder_dismount:
    local.ladder = parm.get 1
    println "STATS: Ladder Dismount"
end

stats_item_pickup:
    // Args: item_name, amount
    local.item = parm.get 1
    local.count = parm.get 2
    println ("STATS: Pickup - Item: " + local.item)
end

stats_item_drop:
    // Args: item_name
    local.item = parm.get 1
    println ("STATS: Drop - Item: " + local.item)
end

stats_player_use:
    // Args: entity
    local.entity = parm.get 1
    println ("STATS: Use - Entity: " + local.entity)
end

// Session Callbacks
stats_client_connect:
    // Args: clientnum
    local.num = parm.get 1
    println ("STATS: Client Connect: " + local.num)
end

stats_client_disconnect:
    println "STATS: Client Disconnect"
end

stats_client_begin:
    println "STATS: Client Begin"
end

stats_team_join:
    // Args: old_team, new_team
    local.old = parm.get 1
    local.new = parm.get 2
    println ("STATS: Team Join - Old: " + local.old + " New: " + local.new)
end

stats_player_say:
    // Args: text
    local.text = parm.get 1
    println ("STATS: Say - " + local.text)
end
