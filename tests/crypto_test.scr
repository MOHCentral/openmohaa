
// This script tests the new crypto commands

void main()
{
    local.text = "Hello World";

    // Test MD5
    local.md5 = md5_string local.text;
    println("MD5 of '" + local.text + "': " + local.md5);

    // Test SHA256
    local.sha256 = sha256_string local.text;
    println("SHA256 of '" + local.text + "': " + local.sha256);

    // Test UUID
    local.uuid = uuid_string;
    println("UUID: " + local.uuid);
}
